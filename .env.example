PORT=3000

# [Opsi 1 - Direkomendasikan] Google OAuth 2.0 (Login dengan Akun Google)
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Set Redirect URI ke: http://localhost:3000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# [Opsi 2 - Fallback] Google Service Account Key
GOOGLE_CREDENTIAL=credential.json